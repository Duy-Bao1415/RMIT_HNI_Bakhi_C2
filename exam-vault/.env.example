NEXT_PUBLIC_QUORUM=2
# S3-compatible storage for encrypted attachments (Neon Storage or AWS S3)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=
